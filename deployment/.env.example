# ============================================================================
# LegalAId Production Cloud Environment Template (AWS ECS / ap-south-1)
# ============================================================================

# Environment identifier (production, staging, development)
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Database Persistence: AWS Aurora PostgreSQL (or Managed SQLite)
DATABASE_URL=postgresql+asyncpg://legalaid_admin:SUPER_SECRET_PASSWORD@legalaid-aurora.cluster-xyz.ap-south-1.rds.amazonaws.com:5432/legalaid_prod
DATABASE_TIMEOUT=30.0

# Storage & Indices (Mount path for AWS EFS)
DATA_DIR=/mnt/efs/data
FAISS_INDEX_DIR=/mnt/efs/indices

# Microservice Discovery (Localhost over awsvpc Task Network)
MCP_SERVER_URL=http://127.0.0.1:8001
VLLM_BASE_URL=http://127.0.0.1:8000/v1

# LLM Providers & Inference Model
LLM_PROVIDER=bedrock
AWS_DEFAULT_REGION=ap-south-1
LLM_MODEL_NAME=anthropic.claude-3-5-sonnet-20241022-v2:0
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Security & Guardrails
API_KEYS=["prod-sec-key-0123456789abcdef", "prod-sec-key-fedcba9876543210"]
SECURITY_TOKEN_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING
RATE_LIMIT_PER_MINUTE=120
GUARDRAILS_ENABLED=true
CORPUS_SIMILARITY_FLOOR=0.55
AUTH_ENABLED=true

# Observability & Tracing
LOG_LEVEL=INFO
ENABLE_TELEMETRY_BRIDGE=true

