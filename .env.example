# Copy to .env and adjust. Every value here has a working default in config.py, so .env is
# optional — it exists for overriding models, ports and tuning without touching code.

# ------------------------------------------------------------------- models
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=ollama
LLM_MODEL=codellama:7b-instruct
LLM_TEMPERATURE=0.1

# Measured on a 6 GB GPU: 2048 -> 15.6 tok/s, 3072 -> 12.0, 4096 -> 9.5 (stops fully
# offloading). Raise only if you have more VRAM.
LLM_NUM_CTX=3072

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# Ollama embedding calls carry ~2.2s fixed overhead each, so batching dominates ingestion
# speed: batch 1 -> 2249 ms/chunk, batch 32 -> 91 ms/chunk.
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------- google gemini
# Optional: Used when LLM_PROVIDER=gemini and/or EMBEDDING_PROVIDER=gemini.
# GEMINI_API_KEY is backend-only. Never expose this secret to frontend/Vite.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------------------------------------------------------------- retrieval
RETRIEVAL_TOP_K_LAWS=8
RETRIEVAL_TOP_K_CASES=5
RETRIEVAL_MIN_SIMILARITY=0.25
RETRIEVAL_ENABLE_KEYWORD=true
RETRIEVAL_ENABLE_GRAPH=true
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_KEYWORD_WEIGHT=0.6

# ------------------------------------------------------------- orchestration
ORCHESTRATOR_MAX_LOOP_ITERATIONS=2

# -------------------------------------------------------------------- system
ENVIRONMENT=dev
LOG_LEVEL=INFO
# 1-5. Gates capabilities so one codebase demonstrates all five exercises.
ACTIVE_PHASE=5
# inprocess | http
SERVICE_TRANSPORT=inprocess

# ------------------------------------------------------------------ database
# SQLite (Local Development default):
# DATABASE_URL=sqlite+pysqlite:///data/legalaid.db
#
# Supabase PostgreSQL (Production / Staging):
# Transaction Pooler (port 6543) or Session Pooler (port 5432):
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct Connection:
# DATABASE_URL=postgresql+psycopg://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# --------------------------------------------------------- supabase storage
# Persistent remote FAISS index storage via Supabase Storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=legalaid-indexes

# -------------------------------------------------------- storage directories
# Mount a Render Persistent Disk at /data in production
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
INDEX_DIR=/data/indexes
KNOWLEDGE_DIR=/data/knowledge_sources

